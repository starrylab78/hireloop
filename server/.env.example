# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://localhost:27017/hireloop

# ---- Auth ----
JWT_ACCESS_SECRET=replace_with_long_random_string_access
JWT_REFRESH_SECRET=replace_with_long_random_string_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
COOKIE_DOMAIN=localhost

# ---- Razorpay ----
# Get these from https://dashboard.razorpay.com/app/keys (use Test mode keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Get this from Dashboard > Account & Settings > Webhooks, after creating a webhook (see README)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Create these Plans in the Razorpay Dashboard (Settings > Plans, test mode) and paste the IDs here
RAZORPAY_PLAN_GROWTH_MONTHLY=plan_xxx_growth_monthly
RAZORPAY_PLAN_GROWTH_ANNUAL=plan_xxx_growth_annual
RAZORPAY_PLAN_SCALE_MONTHLY=plan_xxx_scale_monthly
RAZORPAY_PLAN_SCALE_ANNUAL=plan_xxx_scale_annual

# ---- Email (Resend) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="HireLoop <notifications@hireloop.dev>"

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_RESUME_SIZE_MB=5

# ---- Logging / error tracking ----
LOG_LEVEL=debug
# Get this from https://sentry.io — leave blank to disable error tracking (logs only)
SENTRY_DSN=

# ---- AI job description writer ----
# Get this from https://console.anthropic.com — leave blank to fall back to a filled-in template
ANTHROPIC_API_KEY=

# ---- OAuth sign-in ----
# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# LinkedIn: https://www.linkedin.com/developers/apps — request the "Sign In with LinkedIn using OpenID Connect" product
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback
